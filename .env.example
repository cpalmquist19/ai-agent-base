# Copy to .env and adjust as needed. Loaded automatically on startup via python-dotenv.

# LLM provider: lm_studio (default), openai, anthropic, google, or unsloth
# LLM_PROVIDER=lm_studio

# LM Studio connection (when LLM_PROVIDER=lm_studio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=my-model-id

# OpenAI / ChatGPT (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CONTEXT_WINDOW=128000
# OPENAI_REASONING_EFFORT=none   # required for tool use on reasoning models (default: none)

# Anthropic / Claude (when LLM_PROVIDER=anthropic)
# Uses Anthropic's OpenAI-compatible endpoint, so tools and streaming stay the same.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_CONTEXT_WINDOW=200000
# Claude 4.7 and later reject temperature below 1. Leave unset to use the model default.
# Set only for older Claude models, as a number from 0 to 1.
# ANTHROPIC_TEMPERATURE=
# Required for some multi-workspace keys. See Anthropic "Select a workspace".
# ANTHROPIC_WORKSPACE_ID=

# Google AI Studio / Gemini (when LLM_PROVIDER=google)
# Uses Google's OpenAI-compatible endpoint, so tools and streaming stay the same.
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_AI_STUDIO_API_KEY=...
# GOOGLE_AI_STUDIO_MODEL=gemini-3.8-flash
# GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GOOGLE_AI_STUDIO_CONTEXT_WINDOW=1000000
# Google recommends the model default (1.0) for current Gemini models, so temperature
# is omitted unless set here, as a number from 0 to 2.
# GOOGLE_AI_STUDIO_TEMPERATURE=
# Optional: none, minimal, low, medium, or high. Gemini 3 and 2.5 Pro cannot disable thinking.
# GOOGLE_AI_STUDIO_REASONING_EFFORT=

# Unsloth OpenAI-compatible endpoint (when LLM_PROVIDER=unsloth, or python unsloth_chat.py)
# Default matches vLLM (`vllm serve ...`). llama-server typically uses port 8001.
UNSLOTH_BASE_URL=http://127.0.0.1:8000/v1
UNSLOTH_API_KEY=sk-no-key-required
# UNSLOTH_MODEL=unsloth/Llama-3.2-1B-Instruct

# Generation defaults
LM_STUDIO_MAX_TOKENS=32768
LM_STUDIO_TEMPERATURE=0.3

# Web UI bind address (keep 127.0.0.1 for local-only use)
RELAY_HOST=127.0.0.1
RELAY_PORT=7860

# Extra skill directories (OS path separator: ; on Windows, : on Unix)
# LM_STUDIO_SKILLS_DIRS=C:\path\to\skills

# Playwright inspect_page: set to 1/true/yes to show a visible browser window
# LM_STUDIO_INSPECT_PAGE_HEADED=0

# Allow file tools and cd to access paths outside the open project root / cwd
# LM_STUDIO_ALLOW_UNRESTRICTED_PATHS=0
