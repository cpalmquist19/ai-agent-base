# Copy to .env and adjust as needed. Loaded automatically on startup via python-dotenv.

# LLM provider: lm_studio (default) or openai
# LLM_PROVIDER=lm_studio

# LM Studio connection (when LLM_PROVIDER=lm_studio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# LM_STUDIO_MODEL=my-model-id

# OpenAI connection (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_REASONING_EFFORT=none   # required for tool use on reasoning models (default: none)

# Generation defaults
LM_STUDIO_MAX_TOKENS=32768
LM_STUDIO_TEMPERATURE=0.3

# Web UI bind address (keep 127.0.0.1 for local-only use)
LM_STUDIO_CHAT_HOST=127.0.0.1
LM_STUDIO_CHAT_PORT=7860

# Extra skill directories (OS path separator: ; on Windows, : on Unix)
# LM_STUDIO_SKILLS_DIRS=C:\path\to\skills

# Playwright inspect_page: set to 1/true/yes to show a visible browser window
# LM_STUDIO_INSPECT_PAGE_HEADED=0
